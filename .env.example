# 複製成 .env 後即可啟動開發環境：cp .env.example .env
# 沒有設定的選用變數會使用預設值（以註解列出）。

# ---------- 資料庫（postgres 與 app 共用） ----------

# 資料庫使用者
POSTGRES_USER=appraisal

# 資料庫密碼。這個值只供開發使用；正式環境一定要換成隨機的長密碼
POSTGRES_PASSWORD=dev-only-change-me

# 資料庫名稱
POSTGRES_DB=appraisal

# 選用：資料庫主機名稱（預設 postgres）
# POSTGRES_HOST=postgres

# 選用：資料庫 port（預設 5432）
# POSTGRES_PORT=5432

# ---------- 應用程式 ----------

# 選用：log 等級，DEBUG、INFO、WARNING、ERROR 其中之一（預設 INFO）
# LOG_LEVEL=INFO

# 選用：啟動時等待資料庫的秒數，至少 1（預設 60）
# STARTUP_DB_WAIT_SECONDS=60

# 選用：信任 X-Forwarded-* header 的來源 IP（預設 *）
# FORWARDED_ALLOW_IPS=*

# 選用：前端靜態檔目錄。只在容器以外執行應用程式時使用；
# compose 不會把它傳給 app（runtime image 自己設定）
# STATIC_DIR=

# ---------- 開發環境（compose.override.yaml） ----------

# 選用：發布到 127.0.0.1 的主機 port
# APP_HOST_PORT=8000
# WEB_HOST_PORT=5173
# POSTGRES_HOST_PORT=5432

# 選用：設為 1 時用輪詢偵測檔案變更（Vite 與 uvicorn reload）
# DEV_USE_POLLING=1

# 選用：兩份工作目錄的目錄名稱相同時，用它區分兩份服務
# COMPOSE_PROJECT_NAME=

# ---------- 正式環境專用（只有 compose.prod.yaml 使用） ----------

# 反向代理的 network 名稱（必填，沒有預設值）
# PROXY_NETWORK=

# 對外網域（必填）
# VIRTUAL_HOST=
# LETSENCRYPT_HOST=
